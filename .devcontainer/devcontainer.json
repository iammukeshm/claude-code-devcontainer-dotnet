{
  "name": ".NET 10 + Claude Code (sandboxed)",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "vscode",
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW", "--dns=127.0.0.1"],
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=nuget-packages-${devcontainerId},target=/home/vscode/.nuget/packages,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "postStartCommand": "sudo /usr/local/bin/sandbox-firewall.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "ms-dotnettools.csdevkit"]
    }
  }
}
